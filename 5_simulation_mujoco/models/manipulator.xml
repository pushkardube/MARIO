<mujoco model="manipulator">
  <compiler angle="radian" meshdir="../meshes" autolimits="true"/>

  <option timestep="0.001" gravity="0 0 -9.81">
    <flag warmstart="enable"/>
  </option>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
    <quality shadowsize="4096"/>
    <map stiffness="700" shadowscale="0.5" fogstart="10" fogend="15" zfar="40"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4"/>
    <material name="grid" texture="grid" texrepeat="16 16" texuniform="true" reflectance="0.2"/>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.0 0.0 0.0"
             width="512" height="3072"/>

    <mesh name="base_link"    file="base_link_set_zero.stl"/>
    <mesh name="link_1"       file="link_1_set_zero.stl"/>
    <mesh name="link_2"       file="link_2_set_zero.stl"/>
    <mesh name="link_3"       file="link_3_set_zero.stl"/>
    <mesh name="right_gripper" file="right_gripper_set_zero.stl"/>
    <mesh name="left_gripper"  file="left_gripper_set_zero.stl"/>

    <material name="gray"      rgba="0.627 0.627 0.627 1"/>
    <material name="blue"      rgba="0.792 0.820 0.933 1"/>
    <material name="silver"    rgba="0.776 0.757 0.737 1"/>
    <material name="white"     rgba="0.917 0.917 0.917 1"/>
    <material name="teal"      rgba="0.047 0.471 0.435 1"/>
    <material name="dark_blue" rgba="0.231 0.380 0.706 1"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="base_link"
           directional="false" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"
           pos="0 0 4.0" dir="0 0 -1" castshadow="true"/>
    <light name="ambient" directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"
           pos="0 0 3.0" dir="0 0 -1"/>

    <geom name="floor" type="plane" size="2 2 0.1" material="grid" condim="3"/>

    <!-- base_link at world origin; mesh vertices already in world space at zero config -->
    <body name="base_link" pos="0 0 0">
      <inertial pos="0 0 0.04" mass="0.200" diaginertia="1.5e-04 1.5e-04 8.0e-05"/>
      <geom type="mesh" mesh="base_link" pos="0 0 0" material="gray" contype="0" conaffinity="0"/>
      <geom type="mesh" mesh="base_link" pos="0 0 0" material="gray" group="1" contype="0" conaffinity="0"/>

      <!-- joint_1 (base rotation): world pos [-0.011, 0.0001, 0.0729], axis z -->
      <body name="link_1" pos="-0.011 0.0001 0.0729">
        <inertial pos="0 0 0" mass="0.100" diaginertia="8.0e-05 8.0e-05 4.0e-05"/>
        <joint name="joint_1" type="hinge" axis="0 0 -1"
               range="-3.14 3.14" damping="2.0" armature="0.05"/>
        <!-- geom offset = -joint_1_world -->
        <geom type="mesh" mesh="link_1" pos="0.011 -0.0001 -0.0729" material="white" contype="0" conaffinity="0"/>
        <geom type="mesh" mesh="link_1" pos="0.011 -0.0001 -0.0729" material="white" group="1" contype="0" conaffinity="0"/>

        <!-- joint_2 (shoulder): world pos [-0.0105, -0.0141, 0.1089], axis -y -->
        <!-- local pos = joint_2_world - joint_1_world -->
        <body name="link_2" pos="0.0005 -0.0142 0.036">
          <inertial pos="0 0 0" mass="0.030" diaginertia="1.5e-05 1.5e-05 5.0e-06"/>
          <joint name="joint_2" type="hinge" axis="0 1 0"
                 range="-3.14 3.14" damping="3.0" armature="0.08"/>
          <!-- geom offset = -joint_2_world -->
          <geom type="mesh" mesh="link_2" pos="0.0105 0.0141 -0.1089" material="blue" contype="0" conaffinity="0"/>
          <geom type="mesh" mesh="link_2" pos="0.0105 0.0141 -0.1089" material="blue" group="1" contype="0" conaffinity="0"/>

          <!-- joint_3 (elbow): world pos [-0.0565, -0.0057, 0.1088], axis -z -->
          <!-- local pos = joint_3_world - joint_2_world -->
          <body name="link_3" pos="-0.046 0.0084 -0.0001">
            <inertial pos="0 0 0" mass="0.030" diaginertia="1.5e-05 1.5e-05 5.0e-06"/>
            <joint name="joint_3" type="hinge" axis="0 -1 0"
                   range="-3.14 3.14" damping="2.0" armature="0.05"/>
            <!-- geom offset = -joint_3_world -->
            <geom type="mesh" mesh="link_3" pos="0.0565 0.0057 -0.1088" material="silver" contype="0" conaffinity="0"/>
            <geom type="mesh" mesh="link_3" pos="0.0565 0.0057 -0.1088" material="silver" group="1" contype="0" conaffinity="0"/>

            <!-- right gripper: world pos [-0.0798, -0.0079, 0.0243], axis -z -->
            <!-- local pos = right_gripper_world - joint_3_world -->
            <body name="claw_right" pos="-0.0233 -0.0022 -0.0845">
              <inertial pos="0 0 0" mass="0.005" diaginertia="1.0e-06 1.0e-06 1.0e-06"/>
              <joint name="joint_4" type="hinge" axis="0 0 -1"
                     range="-0.8 0.8" damping="0.2" armature="0.005"/>
              <!-- geom offset = -right_gripper_world -->
              <geom type="mesh" mesh="right_gripper" pos="0.0798 0.0079 -0.0243" material="dark_blue" contype="0" conaffinity="0"/>
              <geom type="mesh" mesh="right_gripper" pos="0.0798 0.0079 -0.0243" material="dark_blue" group="1" contype="0" conaffinity="0"/>
            </body>

            <!-- left gripper: world pos [-0.0798, -0.0006, 0.0243], axis +z -->
            <!-- local pos = left_gripper_world - joint_3_world -->
            <body name="claw_left" pos="-0.0233 0.0051 -0.0845">
              <inertial pos="0 0 0" mass="0.005" diaginertia="1.0e-06 1.0e-06 1.0e-06"/>
              <joint name="joint_5" type="hinge" axis="0 0 1"
                     range="-0.8 0.8" damping="0.2" armature="0.005"/>
              <!-- geom offset = -left_gripper_world -->
              <geom type="mesh" mesh="left_gripper" pos="0.0798 0.0006 -0.0243" material="dark_blue" contype="0" conaffinity="0"/>
              <geom type="mesh" mesh="left_gripper" pos="0.0798 0.0006 -0.0243" material="dark_blue" group="1" contype="0" conaffinity="0"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="joint_1_actuator" joint="joint_1" kp="80"  kv="8"  ctrlrange="-3.14 3.14"/>
    <position name="joint_2_actuator" joint="joint_2" kp="150" kv="15" ctrlrange="-3.14 3.14"/>
    <position name="joint_3_actuator" joint="joint_3" kp="100" kv="10" ctrlrange="-3.14 3.14"/>
    <position name="joint_4_actuator" joint="joint_4" kp="20"  kv="1"  ctrlrange="-0.8 0.8"/>
    <position name="joint_5_actuator" joint="joint_5" kp="20"  kv="1"  ctrlrange="-0.8 0.8"/>
  </actuator>

  <sensor>
    <jointpos name="joint_1_pos" joint="joint_1"/>
    <jointpos name="joint_2_pos" joint="joint_2"/>
    <jointpos name="joint_3_pos" joint="joint_3"/>
    <jointpos name="joint_4_pos" joint="joint_4"/>
    <jointpos name="joint_5_pos" joint="joint_5"/>

    <jointvel name="joint_1_vel" joint="joint_1"/>
    <jointvel name="joint_2_vel" joint="joint_2"/>
    <jointvel name="joint_3_vel" joint="joint_3"/>
    <jointvel name="joint_4_vel" joint="joint_4"/>
    <jointvel name="joint_5_vel" joint="joint_5"/>
  </sensor>
</mujoco>
